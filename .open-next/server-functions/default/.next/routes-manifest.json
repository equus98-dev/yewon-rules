      "regex": "^/admin/rules/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/rules/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/api/admin/articles/[id]",
      "regex": "^/api/admin/articles/([^/]+?)(?:/)?$",
